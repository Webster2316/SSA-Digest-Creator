<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Survey Template</title>
  </head>
  <body>
    <div>
      <table
        role="presentation"
        cellpadding="0"
        cellspacing="0"
        border="0"
        width="100%"
        style="
          max-width: 480px;
          border: 1px solid #ddd9e8;
          background-color: #ffffff;
          font-family: Arial, Helvetica, sans-serif;
        "
      >
        <tr>
          <td style="padding: 24px">
            <p
              style="
                margin: 0 0 6px;
                color: #63558a;
                font-size: 12px;
                font-weight: bold;
                letter-spacing: 1px;
              "
            >
              Surveys and Polls
            </p>

            <h2
              style="
                margin: 0 0 8px;
                color: #25213a;
                font-size: 20px;
                line-height: 28px;
              "
            >
              Survey Title
            </h2>

            <p
              style="
                margin: 0 0 22px;
                color: #666;
                font-size: 13px;
                line-height: 19px;
              "
            >
              Select an answer below. Your response will be recorded when you
              click.
            </p>

            <p
              style="
                margin: 20px 0 0;
                color: #777;
                font-size: 12px;
                line-height: 18px;
              "
            >
              A thank-you page will open after you select an answer.
            </p>
          </td>
        </tr>
      </table>

      <!-- SPACE BEFORE OUTLOOK POLL -->
      <table
        role="presentation"
        width="100%"
        cellpadding="0"
        cellspacing="0"
        border="0"
        style="width: 100%; border-collapse: collapse"
      >
        <tr>
          <td
            height="16"
            style="height: 16px; line-height: 16px; font-size: 16px"
          >
            &nbsp;
          </td>
        </tr>
      </table>
    </div>
  </body>
</html>
